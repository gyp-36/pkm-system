# 生产环境变量模板（复制为 .env.prod，或直接用 deploy/deploy.sh 自动生成）。
# 该文件含机密，切勿提交到仓库。权限应为 600。

# 运行环境
APP_ENV=production
ASSISTANT_TRACE_VIEW_ENABLED=false

# 数据库
POSTGRES_USER=pkm
POSTGRES_DB=pkm
POSTGRES_PASSWORD=用 openssl rand -hex 24 生成

# 模型连接加密主密钥（Fernet）。丢失后已保存的 API Key 无法解密！
# 生成：openssl rand -base64 32 | tr '+/' '-_'
PKM_CREDENTIAL_KEY=用 openssl 生成

# 文件链接签名密钥（JWT HS256）。生成：openssl rand -hex 32
PKM_FILE_LINK_SECRET=用 openssl rand -hex 32 生成

# 对象存储（MinIO）凭据
OBJECT_STORAGE_ACCESS_KEY=用随机大写 hex 生成
OBJECT_STORAGE_SECRET_KEY=用 openssl rand -base64 36 生成
OBJECT_STORAGE_BUCKET=pkm-files

# 公网域名：浏览器访问的主域名 与 对象存储子域名（都要解析到本机并签 HTTPS 证书）
DOMAIN=pkm.example.com
OBJECT_STORAGE_DOMAIN=storage.pkm.example.com

# 前端容器映射到宿主的端口；配 Caddy 时固定 80，由宿主 Caddy 反代到 127.0.0.1:80
WEB_HOST_PORT=80
